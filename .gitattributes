# 关键：本项目的产物要在 Linux 上构建（WSL / CI runner）。
# 任何被 Git 转成 CRLF 的 shell / Python / systemd 单元文件都会在目标机上炸。
* text=auto eol=lf

# 显式钉死，防止 Windows 侧 core.autocrlf=true 污染
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
debian/*    text eol=lf
*.rules     text eol=lf
*.yml       text eol=lf
*.md        text eol=lf

# 永远不要动行尾
*.deb       binary
*.gz        binary
*.xz        binary
