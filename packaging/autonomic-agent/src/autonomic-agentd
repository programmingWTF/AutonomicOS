#!/usr/bin/python3
"""autonomic-agentd -- the agent's resident body in the system.

It holds the identity: the Action counter, the read-only world-version
projection, and the drift check. See ``docs/M1.md`` for why each of those
exists.

As of 0.2 it also *knows whether it can think*. A credential without a
network is still worth nothing, so at boot it resolves the LLM config and
reports what it found -- but it does not call anything. Every real call
belongs to the Action channel, behind dry_run/apply/verify. A daemon that
phones home on startup is not a system citizen, it is a surprise.

Signals
  SIGUSR1  record one Action -- action_seq += 1
  SIGTERM  shut down cleanly
"""

from __future__ import annotations

import json
import os
import signal
import sys
import time

# 配置模块不在默认路径上（它装在 /usr/share/autonomic/），得先指过去。
# 开发期从源码目录跑时，用 AUTONOMIC_LIB 覆盖。
sys.path.insert(0, os.environ.get("AUTONOMIC_LIB", "/usr/share/autonomic"))
import autonomicconf  # noqa: E402  (必须在改完 sys.path 之后)

VERSION = "0.6.0"

STATE_DIR = "/var/lib/autonomic"
STATE_FILE = os.path.join(STATE_DIR, "state.json")
RUNTIME_DIR = "/run/autonomic"
WORLD_MARKER = os.path.join(RUNTIME_DIR, "world")
PID_FILE = os.path.join(RUNTIME_DIR, "agent.pid")

TICK_SECONDS = 5

# ---------------------------------------------------------------- logging
# stdout/stderr go straight to the journal under SyslogIdentifier=
# (and, thanks to LogNamespace=, to their own namespace).


def log(level: str, msg: str) -> None:
    sys.stderr.write("[%s] %s\n" % (level, msg))
    sys.stderr.flush()


# ---------------------------------------------------------------- state


def load_state() -> dict:
    try:
        with open(STATE_FILE, "r") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        data = {}
    data.setdefault("snapshot_id", "bootstrap")
    data.setdefault("action_seq", 0)
    return data


def save_state(state: dict) -> None:
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, STATE_FILE)


def render_world(state: dict) -> str:
    """The world version, as the system is allowed to see it.

    (snapshot_id, action_seq) -- a monotonic counter owned outside the
    system, projected into it read-only.
    """
    return "snapshot_id=%s\naction_seq=%d\n" % (
        state["snapshot_id"],
        state["action_seq"],
    )


def publish_world(state: dict) -> None:
    """Write the marker atomically and leave it read-only.

    0444 is deliberate: not even this process should be able to edit the
    marker in place. Any change goes through a fresh atomic replace, so a
    stray write by anyone else shows up as drift immediately.
    """
    expected = render_world(state)
    os.makedirs(RUNTIME_DIR, exist_ok=True)
    tmp = WORLD_MARKER + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(expected)
    os.chmod(tmp, 0o444)
    os.replace(tmp, WORLD_MARKER)
    return expected


def check_drift(state: dict) -> None:
    expected = render_world(state)
    try:
        with open(WORLD_MARKER, "r") as fh:
            actual = fh.read()
    except OSError:
        return
    if actual != expected:
        log(
            "WARN",
            "world marker drift: expected %r, found %r -- "
            "the world changed without going through the Action channel"
            % (expected.strip().replace("\n", " "), actual.strip().replace("\n", " ")),
        )


# ---------------------------------------------------------------- main


def main() -> int:
    state = load_state()

    os.makedirs(RUNTIME_DIR, exist_ok=True)
    with open(PID_FILE, "w") as fh:
        fh.write("%d\n" % os.getpid())

    def on_action(signum, _frame):
        state["action_seq"] += 1
        save_state(state)
        publish_world(state)
        log("INFO", "action recorded -> action_seq=%d" % state["action_seq"])

    def on_term(signum, _frame):
        log("INFO", "shutting down at action_seq=%d" % state["action_seq"])
        raise SystemExit(0)

    signal.signal(signal.SIGUSR1, on_action)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    # ---- 这条神经系统通不通，开机就该知道，而不是等到真要用的时候才发现 ----
    # 只报告"有没有"，不报告"是什么" —— 密钥本身绝不进日志，一次也不行。
    conf = autonomicconf.load_config()
    key, key_src = autonomicconf.load_api_key()
    if key:
        llm = "llm=%s model=%s (credential via %s)" % (
            conf["base_url"],
            conf["model"],
            key_src,
        )
    else:
        llm = "llm=unconfigured -- identity without a mind; run autonomicctl setup"

    log(
        "INFO",
        "autonomic-agentd %s up (uid=%d gid=%d world=%s#%d %s)"
        % (
            VERSION,
            os.getuid(),
            os.getgid(),
            state["snapshot_id"],
            state["action_seq"],
            llm,
        ),
    )

    publish_world(state)
    while True:
        check_drift(state)
        publish_world(state)
        time.sleep(TICK_SECONDS)


if __name__ == "__main__":
    sys.exit(main())
