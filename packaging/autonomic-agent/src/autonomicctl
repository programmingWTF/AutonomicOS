#!/usr/bin/python3
"""autonomicctl -- ask the system how it sees the agent.

Two things live here:

  * ``status`` -- proof of identity. One command that shows the agent is a
    *role in the system* (a user, a unit, a cgroup, a journal namespace, a
    world marker) rather than a pile of scripts someone left running.

  * ``setup`` / ``llm`` -- the power switch. Without a working base URL and
    key the agent has an identity but no mind: it can count Actions and
    publish a world version, but it cannot think about anything.

  * ``ask`` -- the part that was missing: plain words in, validated plan out.
    The model proposes; the channel disposes. Every plan is checked, then
    previewed end-to-end, then shown to a human, then applied step by step
    with a verify after each step. Nothing is applied before every step has
    passed its dry_run.

  autonomicctl status   the whole identity, in one screen
  autonomicctl world    the read-only world-version marker
  autonomicctl bump     record one Action through the channel (action_seq += 1)
  autonomicctl setup    configure base URL / API key / model, then probe it
  autonomicctl llm      show the current LLM config and check it really works
  autonomicctl ask      "make it do X" -- intent in, audited actions out
  autonomicctl act      run one Action through the channel (preview -> do -> verify)
  autonomicctl actions  list what the channel is willing to do at all
  autonomicctl sense    take one system snapshot, through the channel
  autonomicctl backups  every file the channel overwrote, and how to put it back
  autonomicctl version
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
import signal
import socket
import subprocess
import sys

# pwd / grp 只在 POSIX 上有。它们真正的用场只有一个：cmd_status 里读
# agent 用户的 uid/gid，而那件事本来就只在 Linux 上有意义。
#
# 但**导入期**不该因此炸掉：一个连 import 都过不去的工具，在非 Linux 上
# 连 actions / sense 这些跟平台无关的命令都跑不了，也就等于测不了。
# 所以这里容忍缺失，把"没有它"推迟到真正要用它的那一个命令里去说。
try:
    import grp
    import pwd
except ImportError:  # pragma: no cover - 只在非 POSIX 上走到
    grp = None
    pwd = None

# autonomicconf 装在 /usr/share/autonomic/，那不在 Python 的默认搜索路径里。
# 开发期直接从源码目录跑时，用 AUTONOMIC_LIB 指过去即可。
sys.path.insert(0, os.environ.get("AUTONOMIC_LIB", "/usr/share/autonomic"))
import autonomicconf  # noqa: E402  (必须在改完 sys.path 之后)
import autonomicplan  # noqa: E402  (同上：自然语言 -> 受校验的动作)

VERSION = "0.6.0"

# Action 通道的另一半在这里等着。
ACT_SOCKET = "/run/autonomic/act.sock"

UNIT = "autonomic-agent.service"
AGENT_USER = "autonomic"
STATE_FILE = "/var/lib/autonomic/state.json"
WORLD_MARKER = "/run/autonomic/world"
SENSE_MARKER = "/run/autonomic/sense"
PID_FILE = "/run/autonomic/agent.pid"

# 感知要看哪几样。这不是"能力清单"——能力清单永远来自 actd
# （见 _catalogue_and_meta）。这里只是"这一版想看什么"，是一份**意图**，
# 不是一份许可。真正的许可在 actd 的 _READ_PROBES 里，两边对不上时
# actd 会拒，而这里的循环要知道怎么受着。
_SENSE_METRICS = (
    "os.release", "kernel", "hostname", "uptime",
    "loadavg", "meminfo", "cpuinfo_count", "disk_usage", "timezone",
)
# 这一版顺带看一眼的服务。空手而归也算结果 —— 没装这个服务本身是信息。
_SENSE_UNITS = ("sshd", "systemd-networkd")


def _run(cmd: list[str]) -> str:
    try:
        out = subprocess.run(
            cmd, capture_output=True, text=True, timeout=10
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return out.stdout.strip() if out.returncode == 0 else ""


def _systemctl_show(*props: str) -> dict:
    out = _run(["systemctl", "show", "-p", ",".join(props), UNIT])
    result = {}
    for line in out.splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            result[k.strip()] = v.strip()
    return result


def _read(path: str) -> str:
    try:
        with open(path, "r") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def _cgroup_limits() -> dict:
    """Read the quota straight out of cgroupfs -- that is the proof."""
    cg = _systemctl_show("ControlGroup").get("ControlGroup", "")
    out = {}
    if cg and cg != "/":
        base = "/sys/fs/cgroup" + cg
        for key, fname in (("memory.max", "memory.max"), ("cpu.max", "cpu.max")):
            val = _read(os.path.join(base, fname))
            if val:
                out[key] = val
    return out


def _agent_pid() -> int:
    pid = _systemctl_show("MainPID").get("MainPID", "")
    if pid.isdigit() and int(pid) > 0:
        return int(pid)
    raw = _read(PID_FILE)
    return int(raw) if raw.isdigit() else 0


def _proc_uid(pid: int) -> str:
    if not pid:
        return "n/a"
    for line in _read("/proc/%d/status" % pid).splitlines():
        if line.startswith("Uid:"):
            return line.split()[1]
    return "n/a"


def cmd_status(_args: argparse.Namespace) -> int:
    info = _systemctl_show(
        "ActiveState", "SubState", "MainPID", "MemoryMax", "CPUQuotaPerSecUSec"
    )
    active = info.get("ActiveState", "unknown")
    sub = info.get("SubState", "unknown")
    pid = _agent_pid()

    # ---- identity: a user the system knows about ----
    if pwd is None:
        # 到这一步才说"这台机器上没有 pwd"，而不是在 import 期就把整个
        # CLI 打死。身份查询本来就只在 Linux 上有意义。
        identity = "n/a (this platform has no pwd module)"
    else:
        try:
            pw = pwd.getpwnam(AGENT_USER)
            identity = "%s (uid=%d gid=%d)" % (pw.pw_name, pw.pw_uid, pw.pw_gid)
            try:
                grp_entry = grp.getgrgid(pw.pw_gid)
                identity += " group=%s" % grp_entry.gr_name
            except KeyError:
                pass
        except KeyError:
            identity = "MISSING (user %s does not exist)" % AGENT_USER

    print("Autonomic Agent %s" % VERSION)
    print()
    print("  identity   : %s" % identity)
    print(
        "  process    : pid=%s running-as-uid=%s"
        % (pid if pid else "n/a", _proc_uid(pid))
    )
    print("  unit       : %s%s" % (UNIT, ""))
    print("  state      : %s (%s)" % (active, sub))

    # ---- cgroup: its resource use is bounded ----
    limits = _cgroup_limits()
    if not limits:
        limits = {
            k: v
            for k, v in (
                ("MemoryMax", info.get("MemoryMax", "")),
                ("CPUQuotaPerSecUSec", info.get("CPUQuotaPerSecUSec", "")),
            )
            if v and v != "infinity"
        }
    print("  cgroup     : %s" % (", ".join("%s=%s" % kv for kv in sorted(limits.items())) or "n/a"))
    print("  journal    : journalctl --namespace=autonomic")
    print("  world      : %s" % (_read(WORLD_MARKER).replace("\n", " ") or "n/a"))
    print("  state file : %s" % STATE_FILE)
    print()

    ok = active == "active" and sub == "running"
    print(
        "  => %s"
        % (
            "the agent is a role in this system, not a pile of scripts"
            if ok
            else "NOT RUNNING -- this machine does not currently host an agent"
        )
    )
    return 0 if ok else 1


def cmd_world(_args: argparse.Namespace) -> int:
    marker = _read(WORLD_MARKER)
    if not marker:
        print("no world marker at %s" % WORLD_MARKER, file=sys.stderr)
        return 1
    print(marker)
    try:
        with open(STATE_FILE) as fh:
            print("# source of truth: %s" % json.load(fh))
    except (OSError, ValueError):
        pass
    return 0


def cmd_bump(_args: argparse.Namespace) -> int:
    pid = _agent_pid()
    if not pid:
        print("agent is not running", file=sys.stderr)
        return 1
    os.kill(pid, signal.SIGUSR1)
    print("action recorded through the channel (pid=%d)" % pid)
    return 0


def _mask(key: str) -> str:
    """露一点点够你认出是哪把钥匙，但不至于把整把钥匙递出去。"""
    if len(key) <= 8:
        return "*" * len(key)
    return "%s...%s" % (key[:3], key[-4:])


def _ask(label: str, default: str) -> str:
    try:
        raw = input("  %-10s [%s]: " % (label, default)).strip()
    except EOFError:
        # 非交互的 stdin（比如 CI 里忘了加 --non-interactive），直接吃默认值，
        # 而不是崩在一个 traceback 上。
        return default
    return raw or default


def cmd_llm(args: argparse.Namespace) -> int:
    conf = autonomicconf.load_config()
    key, src = autonomicconf.load_api_key()

    print("Autonomic Agent -- LLM 连接")
    print()
    print("  base_url  : %s" % conf["base_url"])
    print("  model     : %s" % conf["model"])
    print("  timeout   : %ss" % conf["timeout"])
    if key:
        print("  api_key   : %s (来自 %s)" % (_mask(key), src))
    else:
        print("  api_key   : (未配置)")
    print()

    if not key:
        print("  => 没配密钥。这不是故障：这台机器依然是 Autonomic OS，")
        print("     agent 的身份、限额、审计流都还在 —— 它只是还不能思考。")
        print("     通电：sudo autonomicctl setup")
        return 1

    if args.no_probe:
        print("  (--no-probe：没发请求)")
        return 0

    print("  连通性检查 ...")
    res = autonomicconf.probe(
        conf["base_url"], key, autonomicconf.get_timeout(conf)
    )
    if res["ok"]:
        print("  OK   %s" % res["detail"])
        print()
        print("  => agent 这条神经系统是通的。")
        return 0
    print("  FAIL %s" % res["detail"])
    print()
    print("  => 凭据写进去了，但此刻连不通。可能是没网、可能 URL 少了 /v1、")
    print("     也可能这把 key 已经失效。改完重跑 autonomicctl llm 即可。")
    return 1


def cmd_setup(args: argparse.Namespace) -> int:
    if os.geteuid() != 0:
        print(
            "autonomicctl setup: 需要 root（要写 /etc/autonomic/）",
            file=sys.stderr,
        )
        return 1

    conf = autonomicconf.load_config()
    base_url = args.base_url or conf["base_url"]
    model = args.model or conf["model"]
    timeout = int(args.timeout) if args.timeout else autonomicconf.get_timeout(conf)
    key = args.api_key or ""

    existing, _src = autonomicconf.load_api_key()

    if not args.non_interactive:
        print("Autonomic Agent -- LLM 凭据")
        print("直接回车 = 用方括号里的值；密钥不回显。")
        print()
        base_url = _ask("Base URL", base_url)
        model = _ask("模型", model)
        hint = "已配置，回车保留" if existing else "留空则跳过"
        try:
            typed = getpass.getpass("  API Key [%s]: " % hint).strip()
        except EOFError:
            typed = ""
        if typed:
            key = typed
        elif existing:
            key = existing
        print()

    print("写入 %s" % autonomicconf.CONFIG_FILE)
    autonomicconf.write_config(base_url, model, timeout)
    os.chmod(autonomicconf.CONFIG_FILE, 0o644)

    if key:
        print("写入 %s (0640 root:autonomic)" % autonomicconf.CREDENTIALS_FILE)
        autonomicconf.write_api_key(key)
    else:
        print("跳过密钥（留空）。agent 暂时还不能思考。")
        print("以后随时可以回来：sudo autonomicctl setup")
        return 0

    print()
    print("连通性检查 ...")
    res = autonomicconf.probe(base_url, key, timeout)
    if res["ok"]:
        print("  OK   %s" % res["detail"])
        print()
        print("生效： systemctl restart autonomic-agent")
        print("复查： autonomicctl llm")
        return 0

    print("  FAIL %s" % res["detail"])
    print()
    print("凭据已经存好了，只是此刻连不通 —— 没网 / URL 少了 /v1 / key 失效，")
    print("这三样占了九成。修好之后重跑 autonomicctl llm 验证。")
    # 仍然是 0：配置这一步本身是成功的，连通性是另一个变量。
    return 0


def _act_call(action: str, params: dict, phase: str, reason: str = "") -> dict:
    # AF_UNIX 只在 POSIX 上存在，而这个 CLI 在非 Linux 上仍要能被人跑起来
    # 做自检。没有它时给出的是**一句可读的话**，不是一个 AttributeError ——
    # "这台机器上没法跟通道说话"本身就是一个有用的回答。
    af_unix = getattr(socket, "AF_UNIX", None)
    if af_unix is None:
        return {
            "ok": False,
            "detail": "这个平台上没有 AF_UNIX 套接字（本机是 %s），"
                      "Action 通道只存在于 Linux 上" % sys.platform,
        }
    try:
        sock = socket.socket(af_unix, socket.SOCK_STREAM)
        sock.settimeout(60)
        sock.connect(ACT_SOCKET)
    except OSError as exc:
        return {
            "ok": False,
            "detail": "连不上 %s：%s（autonomic-actd 起了吗？）"
            % (ACT_SOCKET, exc),
        }
    try:
        payload = json.dumps(
            {"action": action, "params": params, "phase": phase, "reason": reason}
        )
        sock.sendall((payload + "\n").encode("utf-8"))
        buf = b""
        while not buf.endswith(b"\n") and len(buf) < (1 << 20):
            chunk = sock.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf.decode("utf-8", "replace"))
    except (OSError, ValueError) as exc:
        return {"ok": False, "detail": "通道通信失败：%s" % exc}
    finally:
        sock.close()


def _dump(label: str, res: dict) -> None:
    mark = "OK  " if res.get("ok") else "FAIL"
    print("  %s %-8s %s" % (mark, label, res.get("detail", "")))
    for key, val in sorted((res.get("evidence") or {}).items()):
        print("        %-16s %s" % (key, val))


def cmd_actions(_args: argparse.Namespace) -> int:
    res = _act_call("list", {}, "dry_run")
    cats = res.get("catalogue")
    if not cats:
        print("取不到 action 清单：%s" % res.get("detail"), file=sys.stderr)
        return 1
    print("Action 通道允许的事（就这些，没有别的）：")
    print()
    for item in cats:
        tag = "可逆" if item["reversible"] else "不可逆"
        print("  %-14s %s   参数: %s"
              % (item["name"], tag, ", ".join(item["params"]) or "(无)"))
    print()
    for prefix in res.get("write_allowlist", []):
        print("  可写前缀: %s" % prefix)
    print()
    print("  不在这个清单里的东西，通道不接受 —— 没有 shell 逃生口。")
    return 0


def _sense_once(metric: str) -> dict:
    """向通道要一个指标，并且**只**走通道。

    为什么不让 autonomicctl 自己 open("/proc/loadavg") 就完了 ——
    因为那样做的每一次"看"都不会留痕。agent 半夜看了什么，和改了
    什么一样是审计的一部分；绕过通道的读，账本上查不到。

    更重要的是：agentd 跑在 ProtectProc=invisible 下面，它自己读不到
    这些东西 —— 想让它看，只能让有权限的一方（actd，root）替它读。
    这是 **加能力**，不是 **加权力**：通道仍然是唯一入口，读法仍然是
    actd 里那张闭集表，谁也开不出"读任意文件"的口子。
    """
    return _act_call("sys.read", {"metric": metric}, "dry_run")


def _collect_snapshot() -> dict:
    """把这一版想看的指标全部问一遍，原样收回来。

    刻意返回**结构化的 dict** 而不是一行行文本：`sense` 要把它投影成
    文件，`ask` 要把它交给模型，两者对同一份数据要的是不同形状，而
    **数据本身必须只有一份**。先收成 dict 再各自渲染，两份出口就不可能
    对不上 —— 否则就会出现"模型看着 A、磁盘上存的是 B"，而计划是照着
    A 写的，事后没人知道当时模型看见的世界是什么。

    返回的 dict 里，取不到的项是 `{"unavailable": 原因}`，不是缺席。
    缺席和"明确取不到"是两件事（见 _print_snapshot）。
    """
    collected: dict = {}
    for metric in _SENSE_METRICS:
        res = _sense_once(metric)
        if res.get("ok"):
            collected[metric] = (res.get("evidence") or {}).get("value", "")
        else:
            collected[metric] = {"unavailable": res.get("detail", "")}
    for unit in _SENSE_UNITS:
        res = _act_call("service.status", {"unit": unit}, "dry_run")
        if res.get("ok"):
            ev = res.get("evidence") or {}
            collected["unit.%s" % unit] = {
                "active": ev.get("active", "unknown"),
                "enabled": ev.get("enabled", "unknown"),
            }
        else:
            collected["unit.%s" % unit] = {"unavailable": res.get("detail", "")}
    return collected


def _print_snapshot(collected: dict) -> None:
    """把快照打到屏幕上。取不到的照样打，附上原因。"""
    got = missing = 0
    for key in collected:
        val = collected[key]
        if isinstance(val, dict):
            missing += 1
            print("  %-14s [取不到] %s" % (key, val.get("unavailable", "")))
        else:
            got += 1
            print("  %-14s %s" % (key, val))
    print()
    print("  读到 %d 项，取不到 %d 项。" % (got, missing))


def _render_projection(collected: dict, world: str) -> str:
    """把快照渲染成 /run/autonomic/sense 那份只读文本。

    这里有一条硬规矩：**取不到的项必须出现在文件里**。一份"少了几行"的
    快照看起来像一切正常，一份写着 unavailable 并附原因的才是在说实话。

    而且措辞要保住"这台机器上没有这个文件"和"被沙箱挡住"的区别 ——
    这个区分已经在 actd 里做好了，这里只负责原样带出来，不许压成一句话。
    """
    lines = ["%s=%s" % (key, val) if not isinstance(val, dict)
             else "%s=unavailable (%s)" % (key, val.get("unavailable", ""))
             for key, val in collected.items()]
    return (
        "# 这份快照取自 Action 通道（autonomicctl sense）。\n"
        "# 它经过审计：每一行都对应一次有记录的 sys.read / service.status。\n"
        "# 只读原语不推进世界版本号，所以下面的 world 值和取快照前一致。\n"
        "world=%s\n" % world
    ) + "\n".join(lines) + "\n"


def cmd_sense(args: argparse.Namespace) -> int:
    """取一份系统快照：一次拿全，然后投影成一份只读文本。

    三个刻意的地方：

    1. **要什么指标是写死在这儿的**（_SENSE_METRICS），不是从 actd 问来的
       "有什么就读什么"。问来什么读什么是**漂浮的目标**：actd 加一个
       新原语，agentd 的感知内容就跟着变，快照前后不可比。清单写死在
       这边，两边对不上就是**这条链路有缺口**，应该被看见，不该被吞掉。

    2. **取不到的指标照样写进快照**，标成 unavailable。一份"少了几行"
       的快照和一份"明确写着这几行取不到"的快照，读起来完全是两回事。

    3. **不推进世界版本号。** 它一个字节都没改，所以也不该让 action_seq
       动一下。一个会把版本号推高的读取会让账本失去意义。
    """
    collected = _collect_snapshot()
    print("系统快照（每一项都经由 Action 通道，逐条留痕）")
    print()
    _print_snapshot(collected)
    world = _read(WORLD_MARKER).replace("\n", " ")
    body = _render_projection(collected, world)

    try:
        os.makedirs(os.path.dirname(SENSE_MARKER), exist_ok=True)
        tmp = SENSE_MARKER + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(body)
        os.chmod(tmp, 0o444)
        os.replace(tmp, SENSE_MARKER)
        print("  已投影到 %s（0444，只读）" % SENSE_MARKER)
    except OSError as exc:
        # 投影写不出来不该让"读到了什么"消失 —— 屏幕上已经打过了。
        print("  投影写入失败：%s（快照内容仍然有效，只是没落地）" % exc,
              file=sys.stderr)

    if args.show:
        print()
        print(body, end="")

    # 一项都读不到才算失败。部分读到是正常的（容器里就是这样），
    # 而"部分读到"恰是操作者最需要知道的事实，不该被一个非零返回码
    # 盖过去 —— 那会让人以为整个感知坏了。
    any_ok = any(not isinstance(v, dict) for v in collected.values())
    return 0 if any_ok else 1


def cmd_act(args: argparse.Namespace) -> int:
    params: dict = {}
    for pair in args.param or []:
        key, sep, val = pair.partition("=")
        if not sep:
            print("参数要写成 key=value，收到 %r" % pair, file=sys.stderr)
            return 1
        params[key] = val

    # ---- 第一件事永远是看清楚，而不是先动手 ----
    preview = _act_call(args.action, params, "dry_run", args.reason)
    print("Action: %s" % args.action)
    if params:
        print("  参数  : %s" % ", ".join("%s=%s" % kv for kv in sorted(params.items())))
    if args.reason:
        print("  理由  : %s" % args.reason)
    print()
    if not preview.get("ok"):
        _dump("dry_run", preview)
        return 1
    _dump("dry_run", preview)
    print("  可逆  : %s" % ("是" if preview.get("reversible")
                            else "否 —— 做下去就回不来"))
    if not preview.get("changed"):
        print()
        print("  已经处于目标状态，无需执行。")
        return 0

    if args.phase == "dry_run":
        print()
        print("  (--phase=dry_run：什么都没动)")
        return 0

    # 可逆与否是两级授权：--yes 只是"别问我了"，不可逆的事还得单独点头。
    if not preview.get("reversible") and not args.force_irreversible:
        print()
        print("  这个 action 不可逆。真要继续，请显式加 --force-irreversible。")
        return 1

    if not args.yes:
        try:
            answer = input("\n  真的执行？输入 yes 继续：").strip().lower()
        except EOFError:
            answer = ""
        if answer not in ("yes", "y"):
            print("  取消。什么都没改。")
            return 1

    print()
    applied = _act_call(args.action, params, "apply", args.reason)
    _dump("apply", applied)
    if not applied.get("ok"):
        return 1

    # ---- verify 不是"我相信我做成了"，是去现场再数一遍 ----
    print()
    verified = _act_call(args.action, params, "verify", args.reason)
    _dump("verify", verified)
    bumped = applied.get("sequence_bumped")
    print()
    if verified.get("ok"):
        print("  => %s 完成。世界版本号%s。"
              % (args.action, "已 +1" if bumped else "未变（agent 未在运行）"))
        return 0
    print("  => apply 报成功，但 verify 不认。以 verify 为准 —— 这是有意的：")
    print("     承认存在一个与声称不符的证据，比假装成功重要。")
    return 1


def _catalogue_and_meta() -> tuple[list, dict]:
    """向 actd 要一份"此刻真实存在的能力清单"。

    刻意不用写死在代码里的清单：那份东西从新增第一个原语那天起就开始
    与真身不符，而模型会照着它规划一个并不存在的 API。
    """
    res = _act_call("list", {}, "dry_run")
    if not res.get("ok") or not res.get("catalogue"):
        print("拿不到 Action 清单：%s" % res.get("detail", ""), file=sys.stderr)
        return [], {}
    return res.get("catalogue") or [], res


def cmd_ask(args: argparse.Namespace) -> int:
    """对着系统说一句人话，让它自己把话变成一串受管的动作。

    顺序是这个命令的全部意义所在，打乱任何一个都不行：

        1. 问模型要计划
        2. 结构 + 语义校验（不合格就**整份**退回）
        3. 所有步骤先 dry_run（**全部**通过之前，没有任何一步被 apply）
        4. 人点头（--yes 才能跳过）
        5. 逐步 apply，每一步单独 verify
        6. 中途任何一步失败 => 立刻停，并如实报告已经改了哪几步、怎么还原

    第 3 步先于任何 apply 是硬要求。允许"第 1 步成功、第 3 步被拒"这种
    半成品结果，等于主动制造一个既不是目的地也不是出发点的机器。
    """
    request = " ".join(args.request).strip()
    if not request:
        print("要说什么就写在 ask 后面，例如：")
        print('  autonomicctl ask "把这个主机名的解析写进 /etc/autonomic/hosts 提示"',
              file=sys.stderr)
        return 1

    key, _src = autonomicconf.load_api_key()
    if not key:
        print("这台机器上的 agent 还没有思维 —— 没有配置 LLM 凭据。")
        print()
        print("  autonomicctl setup")
        print()
        print("这不是故障：身份、限额、审计流都在，它只是还不能思考。")
        return 1
    conf = autonomicconf.load_config()

    catalogue, meta = _catalogue_and_meta()
    if not catalogue:
        return 1

    print("请求：%s" % request)
    print("模型：%s" % conf.get("model"))
    print()

    # ---- M10：先看一眼这台机器，再让模型想 ----
    # 快照**只读**、只走通道、不推进世界版本号（_collect_snapshot 只发
    # dry_run）。它同时进提示词和审计文件：模型照着哪份世界做的计划，
    # 三个月后必须还能查得出来。
    #
    # 拿不到快照**不**是致命错误：宁可让模型在信息少一点的情况下做计划，
    # 也不要因为"看不见"就拒绝服务。但要说清楚给了它多少信息。
    sense = _collect_snapshot()
    seen = sum(1 for v in sense.values() if not isinstance(v, dict))
    print("  感知：%d/%d 项可读（已作为上下文交给模型）"
          % (seen, len(sense)))

    asked = autonomicplan.ask_plan(
        conf.get("base_url", ""), key, conf.get("model", ""),
        autonomicconf.get_timeout(conf), request, catalogue, meta,
        sense=sense,
    )
    if not asked.get("ok"):
        print("  模型没给出可用的计划：%s" % asked.get("detail"))
        raw = (asked.get("raw") or "").strip()
        if raw:
            print()
            print("  原文（前 400 字符，完整内容在留痕文件里）：")
            print("    " + raw[:400].replace("\n", "\n    "))
        autonomicplan.record(request, conf.get("model", ""), [], [],
                             raw=raw, elapsed=asked.get("elapsed", 0),
                             context=asked.get("context", ""))
        return 1
    print("  模型思考 %s 秒完成。" % round(asked.get("elapsed", 0), 2))
    context = asked.get("context", "")

    allowlist = tuple(meta.get("write_allowlist") or ())
    denylist = tuple(meta.get("write_denylist") or ())
    plan_obj = asked["plan"]
    steps, errors = autonomicplan.validate(plan_obj, catalogue, allowlist, denylist)
    raw_plan = asked.get("raw", "")

    intent = str(plan_obj.get("intent", "") or "(没说)")
    print("意图：%s" % intent)

    if errors:
        print()
        print("  计划被拒绝，一步都没有执行：")
        for item in errors:
            print("    - %s" % item)
        note = str(plan_obj.get("note", "")).strip()
        if note:
            print("    模型补充：%s" % note)
        autonomicplan.record(request, conf.get("model", ""), [], [],
                             raw=raw_plan, elapsed=asked.get("elapsed", 0),
                             context=context)
        return 1

    if not steps:
        print()
        note = str(plan_obj.get("note", "")).strip()
        print("  模型认为这件事用现有 %d 个原语做不到。" % len(catalogue))
        if note:
            print("  它的说明：%s" % note)
        print()
        print("  这是它有权限说实话的场景 —— 缺能力就去加原语，")
        print("  而不是给它一个 shell 让它绕过自己的边界。")
        autonomicplan.record(request, conf.get("model", ""), [], [],
                             raw=raw_plan, elapsed=asked.get("elapsed", 0),
                             context=context)
        return 0

    print()
    print("计划 %d 步：" % len(steps))
    for pos, step in enumerate(steps, 1):
        print("  %d. %s" % (pos, step["action"]))
        for k, v in sorted(step["params"].items()):
            shown = v if isinstance(v, str) else str(v)
            if len(shown) > 60:
                shown = shown[:57] + "..."
            print("       %-10s %s" % (k, shown.replace("\n", "\\n")))
        print("       理由      %s" % step["reason"])
    print()

    # ---- 全部预演，先于任何一步落地 ----
    previews = []
    failed_at = 0
    for pos, step in enumerate(steps, 1):
        res = _act_call(step["action"], step["params"], "dry_run", step["reason"])
        print("  [%d/%d] dry_run " % (pos, len(steps)), end="")
        _dump(step["action"], res)
        previews.append(res)
        if not res.get("ok"):
            failed_at = pos
            break

    if failed_at:
        print()
        print("  第 %d 步预演失败，整份计划作废 —— 什么都没有改。"
              % failed_at)
        print("  哪怕是前 %d 步看起来可行，也不会先执行它们：那会留下一个"
              % (failed_at - 1))
        print("  既不完整也不原始的状态，比什么都没做糟糕得多。")
        autonomicplan.record(request, conf.get("model", ""), steps, previews,
                             raw=raw_plan, elapsed=asked.get("elapsed", 0),
                             context=context)
        return 1

    if not any(p.get("changed") for p in previews):
        print()
        print("  系统已经就是这个样子了，无需改动。")
        autonomicplan.record(request, conf.get("model", ""), steps, previews,
                             raw=raw_plan, elapsed=asked.get("elapsed", 0),
                             context=context)
        return 0

    irreversible = [str(i) for i, p in enumerate(previews, 1)
                    if not p.get("reversible")]
    if irreversible:
        print()
        print("  第 %s 步不可逆" % ", ".join(irreversible))
        if not args.force_irreversible:
            print("  不可逆的步骤需要再点一次头：加 --force-irreversible。")
            return 1

    if not args.yes:
        try:
            answer = input("\n  执行这 %d 步？输入 yes 继续：" % len(steps)
                           ).strip().lower()
        except EOFError:
            answer = ""
        if answer not in ("yes", "y"):
            print("  取消。世界还是原来那个世界。")
            autonomicplan.record(request, conf.get("model", ""), steps, previews,
                                 raw=raw_plan, elapsed=asked.get("elapsed", 0),
                                 context=context)
            return 1

    # ---- 落地。每一步自己 verify，一步不成就停 ----
    print()
    results = []
    applied = []
    for pos, step in enumerate(steps, 1):
        got = _act_call(step["action"], step["params"], "apply", step["reason"])
        print("  [%d/%d] apply   " % (pos, len(steps)), end="")
        _dump(step["action"], got)
        if not got.get("ok"):
            print()
            print("  第 %d 步失败，后面的步骤不再执行。" % pos)
            break
        applied.append((pos, step, got))
        chk = _act_call(step["action"], step["params"], "verify", step["reason"])
        print("  [%d/%d] verify  " % (pos, len(steps)), end="")
        _dump(step["action"], chk)
        results.append({"pos": pos, "action": step["action"],
                        "apply": got, "verify": chk})
        if not chk.get("ok"):
            print()
            print("  apply 说成了，verify 不认 —— 以 verify 为准。")
            break

    print()
    if not applied:
        print("  什么都没改成。世界版本号未变。")
        autonomicplan.record(request, conf.get("model", ""), steps, results,
                             raw=raw_plan, elapsed=asked.get("elapsed", 0),
                             context=context)
        return 1

    done = min(len(results), len(steps))
    if len(results) == len(steps) and all(r["verify"].get("ok")
                                          for r in results):
        print("  => %d/%d 步完成并核实。世界版本号 +%d。"
              % (len(steps), len(steps), len(steps)))
    else:
        print("  => 只完成 %d/%d 步。" % (done, len(steps)))
        print()
        print("  已经发生改动的部分如下。可逆的原语都留有备份，用")
        print("  autonomicctl backups 可以看到全部，用")
        print("  autonomicctl act file.restore backup=<备份路径> 还原单步：")
        for pos, step, _res in applied:
            backup = (_res.get("evidence") or {}).get("backup", "")
            if backup and not backup.startswith("("):
                print("    第 %d 步 %s -> %s" % (pos, step["action"], backup))

    path = autonomicplan.record(request, conf.get("model", ""), steps, results,
                                raw=raw_plan, elapsed=asked.get("elapsed", 0),
                                context=context)
    if path:
        print()
        print("  留痕：%s" % path)
    return 0 if len(results) == len(steps) and all(
        r["verify"].get("ok") for r in results) else 1


def cmd_backups(_args: argparse.Namespace) -> int:
    """每一次被授权的改动都在这里留着一份原稿。

    这不是"备份功能"，这是**问责**：能改的系统必须能回答"改之前是什么样"，
    并且能亲手把它放回去。
    """
    root = "/var/lib/autonomic/backups"
    try:
        names = sorted(os.listdir(root), reverse=True)
    except OSError as exc:
        print("读不到备份目录 %s：%s" % (root, exc), file=sys.stderr)
        print("（还没有任何动作改动过文件，说明通道至今没写过东西。）")
        return 1
    if not names:
        print("还没有任何备份 —— 通道至今没有被用来改写过文件。")
        return 0
    print("备份目录 %s（新的在前）：" % root)
    print()
    shown = 0
    for name in names:
        if name.endswith(".json"):
            continue
        full = os.path.join(root, name)
        meta_path = full + ".json"
        target, at, sha = "?", "?", "?"
        try:
            with open(meta_path, "r", encoding="utf-8") as fh:
                meta = json.load(fh)
            target = meta.get("path", "?")
            at = meta.get("at", "?")
            sha = (meta.get("sha256", "") or "")[:12]
        except (OSError, ValueError):
            target = "(缺 sidecar，无法自动还原)"
        print("  %s" % name)
        print("      原位置 %s" % target)
        print("      时间   %s   sha256前12 %s" % (at, sha))
        if target.startswith("/"):
            print("      还原   autonomicctl act file.restore backup=%s" % full)
        print()
        shown += 1
        if shown >= 20:
            print("  ...（只显示最近 20 条，完整列表看目录本身）")
            break
    return 0


def cmd_version(_args: argparse.Namespace) -> int:
    print("autonomicctl %s" % VERSION)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="autonomicctl", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="show the agent's identity in this system").set_defaults(fn=cmd_status)
    sub.add_parser("world", help="show the read-only world-version marker").set_defaults(fn=cmd_world)
    sub.add_parser("bump", help="record one Action through the channel").set_defaults(fn=cmd_bump)

    setup = sub.add_parser(
        "setup", help="configure LLM base URL / API key / model, then probe it"
    )
    setup.add_argument("--base-url", default="", help="OpenAI-compatible API root")
    setup.add_argument("--model", default="", help="model name")
    setup.add_argument("--api-key", default="", help="the secret; prefer interactive")
    setup.add_argument("--timeout", default="", help="request timeout in seconds")
    setup.add_argument(
        "--non-interactive",
        action="store_true",
        help="take everything from flags (for CI / unattended installs)",
    )
    setup.set_defaults(fn=cmd_setup)

    llm = sub.add_parser(
        "llm", help="show LLM config and check the endpoint really answers"
    )
    llm.add_argument(
        "--no-probe", action="store_true", help="print config only, send nothing"
    )
    llm.set_defaults(fn=cmd_llm)

    sub.add_parser(
        "actions", help="list every Action the channel accepts (there is no shell escape)"
    ).set_defaults(fn=cmd_actions)

    sense = sub.add_parser(
        "sense", help="take one system snapshot, every read going through the channel"
    )
    sense.add_argument("--show", action="store_true",
                       help="also print the projected snapshot to stdout")
    sense.set_defaults(fn=cmd_sense)

    act = sub.add_parser(
        "act", help="run one Action: always preview first, verify at the end"
    )
    act.add_argument("action", help="e.g. file.write, service.set, sysctl.set, self.test")
    act.add_argument("param", nargs="*", metavar="key=value",
                     help="action parameters")
    act.add_argument("--phase", default="apply", choices=("dry_run", "apply"),
                     help="dry_run = preview only (default: apply)")
    act.add_argument("--reason", default="", help="why; recorded in the journal")
    act.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    act.add_argument(
        "--force-irreversible", action="store_true",
        help="required in addition to --yes for irreversible actions",
    )
    act.set_defaults(fn=cmd_act)

    ask = sub.add_parser(
        "ask", help="say what you want in plain words; get a validated plan",
    )
    ask.add_argument("request", nargs="+", help="what you want done")
    ask.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    ask.add_argument(
        "--force-irreversible", action="store_true",
        help="in addition to --yes, if any step cannot be undone",
    )
    ask.set_defaults(fn=cmd_ask)

    sub.add_parser(
        "backups", help="every file the channel overwrote, and how to put it back"
    ).set_defaults(fn=cmd_backups)

    sub.add_parser("version", help="print version").set_defaults(fn=cmd_version)
    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
