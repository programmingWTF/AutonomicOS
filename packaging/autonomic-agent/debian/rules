#!/usr/bin/make -f
# Autonomic OS -- autonomic-agent
#
# 刻意不用任何语言特定的构建系统：这个包目前只是把已经写好的文件
# 放到正确的位置，剩下的（用户、目录、unit 启用）交给 postinst 和
# debhelper 生成的 systemd 片段。
#
# 可复现构建：SOURCE_DATE_EPOCH 由 build/build.sh 导出，
# 别在这里用 date。

export DH_VERBOSE=1

%:
	dh $@

# 没有上游构建系统，全部跳过（否则 dh 会去找 Makefile）
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:
override_dh_auto_clean:

# unit 是配置文件不是可执行体。源文件在开发机上常常带着执行位（尤其是
# Windows 上建出来的），dh_install 会原样保留，于是 dpkg 每次升级都来一句
# "marked executable"。与其指望每个人的 umask，不如在这儿钉死。
execute_after_dh_install:
	chmod 0644 debian/autonomic-agent/lib/systemd/system/autonomic-actd.service
